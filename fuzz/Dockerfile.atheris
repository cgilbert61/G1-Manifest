# Coverage-guided Python fuzzing container (Google Atheris / libFuzzer)
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml requirements.txt README.md LICENSE ./
COPY estate_graph ./estate_graph
COPY fuzz ./fuzz

RUN pip install --no-cache-dir -e ".[host,fuzz]" pytest atheris

CMD ["sh", "-c", "pytest -v fuzz/ && python fuzz/run_atheris.py --runs 2000"]
